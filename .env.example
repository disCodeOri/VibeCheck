# Local server only. Cloud deployment uses its Lambda IAM role, never browser keys.
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
USE_REKOGNITION=true
# Optional alternative for local development: AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FALLBACK_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

PORT=8787

# Optional: interpreter used by POST /api/face/align (scripts/align_face.py,
# needs opencv-python and numpy). Defaults to python3, or python on Windows.
# The route returns 503 FACE_ALIGN_UNAVAILABLE when it is not installed.
PYTHON_BIN=
